# Ponte MQTT mTLS: espelha topicos elo5/# do elo5-mosquitto para cpd-mosquitto
connection bridge-elo5-system2
address elo5-mosquitto:8883
clientid cpd-bridge-elo5

topic elo5/# in 1

cleansession false
try_private true
notifications false
start_type automatic
restart_timeout 10

bridge_protocol_version mqttv311
bridge_tls_version tlsv1.2
bridge_cafile /mosquitto/certs/ca.crt
bridge_certfile /mosquitto/certs/server.crt
bridge_keyfile /mosquitto/certs/server.key
bridge_insecure false
